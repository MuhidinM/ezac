# Copy to .env.local for development, or to .env.production on the server, and fill in.
# Values set in the shell (or by pm2) win over these files. Details: README.md.

# Gateway address. Required in production; there is no default there.
# Local gateway: http://localhost:8090. UAT and production: the https address you were given.
API_BASE_URL=http://localhost:8090

# The rest are optional: uncomment the ones you need.

# Path to the gateway's certificate while it is self-signed (UAT), e.g. certs/uat-ezac.pem.
# Node reads it only at process start; `pnpm dev:uat` and `pnpm start:uat` set it for you.
# NODE_EXTRA_CA_CERTS=

# Google Maps key for the home page impact map. Read at build time.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Exact public origin users open (scheme, host and port), e.g. https://ezac.gov.et.
# Enables sitemap.xml and absolute metadata URLs, and is the origin allowed to save
# through /bff when the reverse proxy rewrites Host. Set it before building.
# SITE_URL=

# Release id for log lines. The deploy sets it.
# GIT_SHA=

# true only on a test host served over plain HTTP (no TLS). Never in production.
# ALLOW_INSECURE_AUTH_COOKIES=true

# true only if the gateway issues staff accounts without an ADMIN, BRANCH or FIELD_OFFICER
# role and they should keep access. Without it, such accounts get no portal access.
# TRUST_ROLELESS_ACCOUNTS=true
